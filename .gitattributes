# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.dmg filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
dist/*.exe filter=lfs diff=lfs merge=lfs -text
dist/*.dmg filter=lfs diff=lfs merge=lfs -text
assets/video filter=lfs diff=lfs merge=lfs -text
assets/video/Cut-Scene-Opening[[:space:]](1).ogv filter=lfs diff=lfs merge=lfs -text
assets/video/cut-ending[[:space:]](1).ogv filter=lfs diff=lfs merge=lfs -text
assets/video/Cut-Scene-Opening.mp4 filter=lfs diff=lfs merge=lfs -text
assets/video/cut-ending.mp4 filter=lfs diff=lfs merge=lfs -text
